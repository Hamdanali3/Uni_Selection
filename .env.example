# UniSelection Environment Configuration Example
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit the real .env.local or any secret keys to git.

# ──────────────────────────────────────────────
# Supabase (Public / Client-Safe)
# ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/Public JWT key – found in Supabase Dashboard → Project Settings → API
# Safe for client apps when Row Level Security (RLS) is enabled.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ──────────────────────────────────────────────
# Supabase (Server-Side Only – NEVER put in mobile client)
# ──────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-commit
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# ──────────────────────────────────────────────
# Database (for migrations / server-side tools)
# ──────────────────────────────────────────────
# Transaction-mode pooler – used by app/ORM queries
# DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler – used for schema migrations (e.g. Prisma migrate)
# DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────
# App Settings
# ──────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
ENABLE_OFFLINE_SEED_MODE=true     # Allows app to work with offline seed data when Supabase is not connected
API_TIMEOUT_SECONDS=15
APP_VERSION=1.0.0
