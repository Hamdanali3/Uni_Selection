# UniSelection Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env or any secret keys to git.

# Supabase Public Configuration (Safe for client apps with RLS enabled)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Admin / Service Role (STRICTLY FOR SERVER-SIDE / CI MIGRATIONS ONLY - NEVER PUT IN MOBILE CLIENT)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-commit

# App Environment
ENVIRONMENT=development # development | staging | production
ENABLE_OFFLINE_SEED_MODE=true # Allows mobile app to function with rich offline seed data when Supabase is not yet connected
API_TIMEOUT_SECONDS=15
APP_VERSION=1.0.0
